{
  "name": "Vulto",

  // Deliberately thin, and deliberately pointed at the same compose file the
  // local path uses. A devcontainer with its own image definition drifts from
  // the local setup until it is a second, wrong environment; one that shares
  // the compose file cannot disagree with it, because it is the same file.
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.devcontainer.yml"],
  "service": "workspace",

  // Must match the mount target in docker-compose.devcontainer.yml, and must be
  // the repository rather than its parent. Codespaces independently mounts the
  // parent directory at /workspaces, so /workspaces/vulto is the repository in
  // both environments and the two mounts agree rather than compete.
  "workspaceFolder": "/workspaces/vulto",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24.18.0" },
    "ghcr.io/devcontainers/features/rust:1": { "version": "1.97.1" }
  },

  // Rust is present here and absent from a contributor's laptop, and that is
  // the point rather than an inconsistency. A007-T19 makes the development
  // image the thing that satisfies A001-T04: someone working on the sync engine
  // gets a toolchain without every TypeScript contributor needing one.
  "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile",

  "forwardPorts": [3100, 3101, 5432, 6379, 8080],
  "portsAttributes": {
    "3100": { "label": "roster-web" },
    "3101": { "label": "api" },
    "5432": { "label": "postgres" },
    "6379": { "label": "redis" },
    "8080": { "label": "sync-engine (placeholder)" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "rust-lang.rust-analyzer"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },

  // `vscode`, not `node`. The `node` user exists in the javascript-node images;
  // the `base` images this overlay uses create `vscode`. Naming a user the image
  // does not have builds every layer successfully and then discards the whole
  // container with "unable to find user node: no matching entries in passwd
  // file" — the last line of a log whose every prior step passed.
  //
  // Installing the Node feature does not create a user called `node`. It
  // installs Node into /usr/local/share/nvm and leaves users alone.
  "remoteUser": "vscode"
}
