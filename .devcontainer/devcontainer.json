{
  "name": "Vulto",

  // Deliberately thin, and deliberately pointed at the same compose file the
  // local path uses. A devcontainer with its own image definition drifts from
  // the local setup until it is a second, wrong environment; one that shares
  // the compose file cannot disagree with it, because it is the same file.
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.devcontainer.yml"],
  "service": "workspace",

  // Must match the mount target in docker-compose.devcontainer.yml, and must be
  // the repository rather than its parent. Codespaces independently mounts the
  // parent directory at /workspaces, so /workspaces/vulto is the repository in
  // both environments and the two mounts agree rather than compete.
  "workspaceFolder": "/workspaces/vulto",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24.18.0" },
    // docker-outside-of-docker, not docker-in-docker. The workspace container
    // needs to run `docker compose` against the SAME daemon that already runs
    // its siblings — postgres, redis, electric, brought up by the outer
    // compose file this devcontainer extends. docker-in-docker would start a
    // second, isolated daemon inside the workspace container that cannot see
    // those siblings at all: `docker compose ps` from a terminal in the
    // Codespace would show nothing, because the containers it's asking about
    // aren't on that daemon. Outside-of-docker mounts the host's socket
    // instead, so `docker` commands here see and control the stack that is
    // already running rather than a second one nested inside it. Also
    // lighter: no nested daemon to boot.
    //
    // Neither VPS-A007's Docker section nor A007-T14 states a preference
    // between the two — checked before adding this, so this is a fresh
    // decision rather than a contradiction of one already made.
    //
    // `moby: false` installs Docker CE's CLI from Docker's own apt repository
    // instead of Moby's packages from Debian's. The feature defaults `moby` to
    // true, and Debian trixie does not carry `moby-cli`, so the default fails
    // the feature's install step outright:
    //
    //   (!) The 'moby' option is not supported on debian 'trixie' because
    //       'moby-cli' and related system packages are not available in that
    //       distribution.
    //
    // Docker CE does publish for trixie, so this is the fix the feature itself
    // recommends first. The alternative it offers — moving the base image to
    // bookworm — is rejected below.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false }
  },

  "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile",

  "forwardPorts": [3100, 3101, 5432, 6379, 5133],
  "portsAttributes": {
    "3100": { "label": "roster-web" },
    "3101": { "label": "api" },
    "5432": { "label": "postgres" },
    "6379": { "label": "redis" },
    "5133": { "label": "electric" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "dbaeumer.vscode-eslint"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },

  // `vscode`, not `node`. The `node` user exists in the javascript-node images;
  // the `base` images this overlay uses create `vscode`. Naming a user the image
  // does not have builds every layer successfully and then discards the whole
  // container with "unable to find user node: no matching entries in passwd
  // file" — the last line of a log whose every prior step passed.
  //
  // Installing the Node feature does not create a user called `node`. It
  // installs Node into /usr/local/share/nvm and leaves users alone.
  "remoteUser": "vscode"
}
