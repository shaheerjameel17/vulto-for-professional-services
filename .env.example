# Copy to .env for local development. `pnpm stack:up` provides these defaults.
DATABASE_URL=postgres://vulto:vulto@localhost:5432/vulto
REDIS_URL=redis://localhost:6379
API_PORT=3101
API_HOST=127.0.0.1
API_ORIGIN=http://localhost:3101
WEB_ORIGIN=http://localhost:3100
AUTH_TRUSTED_ORIGINS=http://localhost:3100
# Generate at least 32 random bytes; never reuse this example value in production.
BETTER_AUTH_SECRET=local-development-only-change-me-32-bytes
PASSKEY_RP_ID=localhost
# Google SSO is enabled only when both are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=info
