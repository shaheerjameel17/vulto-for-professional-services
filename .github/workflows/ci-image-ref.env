# The one place the CI image is pinned. Read by fast-lane.yml and slow-lane.yml
# (via their `resolve-image` job), never duplicated into a `container:` literal.
#
# A007-T16: this MUST be a digest pin (`...@sha256:...`), not a moving tag.
# Changing it is a reviewed PR — the same treatment the
# docker-compose base images get. Rebuild + repin with `ci-image.yml`
# (workflow_dispatch, or a push touching `.docker/ci/**`), then paste the
# digest it prints in its job summary.
CI_IMAGE=ghcr.io/shaheerjameel17/vulto-for-professional-services/ci@sha256:b16ea18414607d5a8f70ef8fc2fbaf9a71d25f4854dc7832beccdae520c65a37

# The Postgres the slow lane's service containers run (F203). It carries the
# logical-replication flags in its default command, which a GitHub Actions
# service container cannot set. Published by ci-image.yml (run 35621870496,
# 21 September 2026); the base is the same postgres:17-alpine digest as before.
CI_POSTGRES_IMAGE=ghcr.io/shaheerjameel17/vulto-for-professional-services/ci-postgres@sha256:eec77295062736b9aa8468fe3f370b5a9e89931e4887827ead61d1c0e5792cfe
