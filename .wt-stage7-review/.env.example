# Copy to .env for local development. `pnpm stack:up` provides these defaults.
DATABASE_URL=postgres://vulto:vulto@localhost:5432/vulto
REDIS_URL=redis://localhost:6379
API_PORT=3101
API_HOST=127.0.0.1
API_ORIGIN=http://localhost:3101
WEB_ORIGIN=http://localhost:3100
AUTH_TRUSTED_ORIGINS=http://localhost:3100
# Generate at least 32 random bytes; never reuse this example value in production.
BETTER_AUTH_SECRET=local-development-only-change-me-32-bytes
PASSKEY_RP_ID=localhost
# Google SSO is enabled only when both are present.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOG_LEVEL=info
# Electric (the sync service). The local secret is for local development only.
ELECTRIC_URL=http://localhost:5133
ELECTRIC_SECRET=7410a5d35c4ace6ceceb2de9e5c0ac32
# The key provider has no default. `local` is accepted only when NODE_ENV is development or test.
NODE_ENV=development
VULTO_KEY_PROVIDER=local
# Local development ONLY — NEVER use this value in production. Base64, 32 bytes.
VULTO_LOCAL_ROOT_KEY=D6QVNEsijEoJKnNdcu+/ez0N8rkLsdewyxeCwTYX7LA=
# AWS KMS (production key provider). Empty locally.
AWS_REGION=
VULTO_KMS_ROOT_KEY_ARN=
# The read-only database role Electric connects as (created by a migration). Local only.
ELECTRIC_DB_PASSWORD=vulto-electric-local-only
